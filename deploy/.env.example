# Copy to repository-root .env. Supply actual secrets and local artifacts.
JURY_API_KEY=replace_with_random_secret
UI_ORIGIN=https://review.example.org
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
ML_IMAGE=
