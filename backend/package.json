    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@apidevtools/swagger-parser": "12.1.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3"
