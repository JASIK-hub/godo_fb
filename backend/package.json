    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@apidevtools/swagger-parser": "^12.0.0",
    "supertest": "^7.1.0",
    "typescript": "^5.9.0"
