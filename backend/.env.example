NODE_ENV=development
PORT=3000
# Generate a random jury key (32 bytes recommended). Never commit .env.
JURY_API_KEY=replace_with_random_secret
UI_ORIGIN=http://localhost:5173
# Explicit opt-in. Only allowed with NODE_ENV=development or test.
ML_STUB_ENABLED=false
# Internal ML URLs. Legacy ML_URL remains supported as a fallback.
ML_SERVICE_URL=http://ml:8000/analyze
ML_HEALTH_URL=http://ml:8000/health/ready
ML_ALLOWED_HOSTS=ml,localhost,127.0.0.1,[::1]
ML_API_KEY=
ML_TIMEOUT_MS=180000
JOB_DEADLINE_MS=300000
DEADLINE_MARGIN_MS=5000
MEDIA_TIMEOUT_MS=30000
UPLOAD_TIMEOUT_MS=60000
MAX_UPLOAD_BYTES=104857600
MAX_VIDEO_DURATION_SECONDS=3600
MAX_PENDING_JOBS=1
ML_CONCURRENCY=1
MAX_STORED_JOBS=1000
JOB_TTL_MS=3600000
VIDEO_RETENTION_MS=3600000
CLEANUP_INTERVAL_MS=60000
DATA_DIR=./data
# Optional production frontend build directory. Empty disables static serving.
STATIC_DIR=
RULES_PATH=./config/rules.json
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
