NODE_ENV=development
PORT=3000
# Generate independent random secrets (at least 32 characters). Never commit .env.
API_KEY=
UI_ACCESS_CODE=
UI_ORIGIN=http://localhost:5173
# Explicit opt-in. Only allowed with NODE_ENV=development or test.
ML_STUB_ENABLED=false
# Full endpoint URL, required when stub is disabled. HTTPS required in production.
ML_URL=
ML_API_KEY=
ML_TIMEOUT_MS=120000
MAX_UPLOAD_BYTES=104857600
MAX_PENDING_JOBS=10
ML_CONCURRENCY=2
MAX_STORED_JOBS=1000
JOB_TTL_MS=3600000
SESSION_TTL_MS=3600000
